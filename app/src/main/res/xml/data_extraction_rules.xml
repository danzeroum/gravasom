<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault" />
        <exclude domain="file" path="recordings" />
        <exclude domain="file" path="Recordings" />
        <!-- Preferencias ficam no DataStore (files/datastore), nao em SharedPreferences. -->
        <exclude domain="file" path="datastore" />
        <exclude domain="database" path="gravasom.db" />
        <!-- Keyset do cofre embrulhado por chave do Keystore deste aparelho: inutil (e confuso) em outro. -->
        <exclude domain="sharedpref" path="gravasom_vault_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault" />
        <exclude domain="file" path="Recordings" />
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="gravasom_vault_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
